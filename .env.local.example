# SAP OData Gateway — server-side only (never exposed to the browser)
SAP_BASE_URL=https://your-s4hana.example.com:8000
SAP_USERNAME=SAPUSER
SAP_PASSWORD=yourpassword

# Set to "true" to use built-in demo data instead of SAP (no SAP needed)
DEMO_MODE=true

# App
NEXT_PUBLIC_APP_NAME="PS Project Manager"
